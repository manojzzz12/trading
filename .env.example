# ==============================================================================
# Trader-Swing Environment Configuration Template (.env.example)
# Copy this file to .env and configure your local settings.
# Never commit real secrets or production credentials to source control.
# ==============================================================================

# --- Mandatory Security Configuration ---
# 16+ byte cryptographically secure secret key used for HMAC-SHA256 order authorization tokens.
# To generate a random 32-character hex secret, run in PowerShell:
#   python -c "import secrets; print(secrets.token_hex(16))"
TRADER_AUTH_SECRET=

# --- SEC EDGAR Integration (Optional / Recommended for trader-analyst & trader-news) ---
# SEC EDGAR requires a user-agent header identifying your application and email.
# Format: "SampleApp UserAdmin<user@example.com>"
SEC_USER_AGENT=

# --- Alpaca Market Data & Paper Trading (Optional) ---
# If using Alpaca for paper trading or real-time market data:
# Defaults to the Alpaca Paper Trading endpoint.
ALPACA_API_BASE_URL=https://paper-api.alpaca.markets
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- Custom State Storage Directories (Optional) ---
# By default, Trader-Swing isolates state in your user Documents folder:
#   Windows: C:\Users\<username>\Documents\TradingPaperState
#   Linux/macOS: ~/Documents/TradingPaperState
# You can override these paths by specifying absolute paths below:
# TRADING_PAPER_STATE_DIR=C:\path\to\custom\paper_state
# TRADING_PAPER_SIMULATION_DIR=C:\path\to\custom\simulation_state
