.pytest_cache/
.qodo/
.ruff_cache/
.mypy_cache/

# Databases and local caches
*.db
*.sqlite
*.sqlite3

# Environments
.env
.env.*
!.env.example
.venv/
env/
venv/
ENV/

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

